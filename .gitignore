# Built application files
*.apk
*.aar
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
release/

# Gradle
.gradle/
build/

# Local configuration file (SDK path, signing, etc.)
local.properties

# Log files
*.log

# Android Studio / IntelliJ
*.iml
# `.idea/*`, not `.idea/`: git cannot re-include a path inside an excluded *directory*,
# so the negation below would silently do nothing.
.idea/*
# The one exception - the shared spelling dictionary. Without it every reader's IDE
# flags the project's own vocabulary (Snackbar, ktlint, favorited, recomposition) as typos.
!.idea/dictionaries/
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Kotlin
.kotlin/

# Signing material — never commit
*.jks
*.keystore
keystore.properties

# Crash / profiling dumps
*.hprof

# Third-party service configs
google-services.json

# OS cruft
.DS_Store
Thumbs.db

# --- AI coding-agent scaffolding (kept local, not part of the app) ---
AGENTS.md
CLAUDE.md
CLAUDE.local.md
.claude/*
!.claude/skills/
.cursor/
.cursorrules
.aider*
.windsurfrules
.github/copilot-instructions.md
